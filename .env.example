# App
NODE_ENV=development
APP_PORT=5051
LOG_LEVEL=info

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://dmdoc:dmdoc@localhost:5432/dmdoc

# Redis (BullMQ)
REDIS_URL=redis://localhost:5052

# Storage de arquivos — S3, MinIO (dev) ou Cloudflare R2 (prod alternativo)
#
# Dev local com MinIO (docker-compose):
#   AWS_REGION=us-east-1
#   AWS_S3_BUCKET=dmdoc-documents
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   S3_ENDPOINT=http://localhost:5054
#   S3_PUBLIC_ENDPOINT=http://localhost:5054   # = S3_ENDPOINT no host; no compose, S3_ENDPOINT é http://minio:9000
#   S3_FORCE_PATH_STYLE=true
#
# Cloudflare R2 (produção):
#   AWS_REGION=auto
#   AWS_S3_BUCKET=dmdoc-documents
#   AWS_ACCESS_KEY_ID=<r2-access-key>
#   AWS_SECRET_ACCESS_KEY=<r2-secret-key>
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=                         # vazio: o endpoint do R2 já é público
#   S3_FORCE_PATH_STYLE=false
#
AWS_REGION=us-east-1
AWS_S3_BUCKET=dmdoc-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Endpoint público para assinar URLs de download (browser-reachable). Em dev com
# MinIO via Docker, o S3_ENDPOINT é o host interno (minio:9000) inacessível pelo
# navegador — setar este como a porta publicada. Vazio em produção (R2/S3 já públicos).
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Chave mestra do storage por empresa (AES-256-GCM) — 32 bytes em HEX (64 chars).
# Cifra o segredo de acesso (access key do S3 do cliente, client secret do SharePoint)
# que cada empresa grava no banco. Gere com:
#
#   openssl rand -hex 32
#
# ⚠️ A MESMA chave precisa estar na api e no worker (os dois decifram).
# ⚠️ Trocar a chave torna ILEGÍVEL todo segredo já cifrado no banco — as empresas com
#    storage próprio param de funcionar até reconfigurarem as credenciais na mão.
#    Não versione o valor real; guarde-o junto dos demais segredos do ambiente.
STORAGE_SECRET_KEY=8bbe971cc19e768b691b61268d4be07a85c48678e98b5e9f492f223d3a4e7afd

# Extração de texto
# Comunicação assíncrona via Redis: o worker resolve o destino de armazenamento da
# empresa, assina uma URL temporária e enfileira { fileUrl, mimeType, filename } em
# 'extract:requests'; o Python baixa por HTTP e publica o resultado em
# 'extract:result:{requestId}'. O extractor não fala com bucket nenhum.
# Timeout do BLPOP aguardando resultado (segundos). Default 15min.
# 0 bloqueia indefinidamente (não recomendado em produção).
EXTRACT_BLPOP_TIMEOUT_SECS=900
# Validade da URL entregue ao extractor (segundos). Default 30min.
# Cobre FILA + PROCESSAMENTO, não só o download: o extractor processa um pedido por
# vez, então um documento grande segura os seguintes na fila. Manter com folga sobre
# EXTRACT_BLPOP_TIMEOUT_SECS — URL que expira antes do BLPOP desistir vira erro de
# download confuso em vez de um timeout claro.
EXTRACT_URL_TTL_SECS=1800

# LLM
# "openai" para produção, "openrouter" para testes gratuitos
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-3-27b-it:free

# Embeddings (sempre OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Limites
MAX_UPLOAD_MB=50
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Atlas Search / Vector Search (create-atlas-indexes)
# O script usa o driver MongoDB nativo (collection.createSearchIndexes) — não
# requer Atlas Admin API. Estas variáveis são reservadas para uso futuro caso
# seja necessário gerenciar índices via Management API diretamente.
# ATLAS_PUBLIC_KEY=
# ATLAS_PRIVATE_KEY=
# ATLAS_PROJECT_ID=
# ATLAS_CLUSTER_NAME=
